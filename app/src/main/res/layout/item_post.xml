<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="10dp"
    android:layout_marginBottom="10dp"
    android:background="@drawable/post_card_bg"
    android:orientation="vertical"
    android:paddingTop="20dp"
    android:clickable="true"
    android:focusable="true"
    android:onClick="openPostDetails">

    <!-- Post Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">

        <androidx.cardview.widget.CardView
            android:layout_width="40dp"
            android:layout_height="40dp"
            app:cardBackgroundColor="#E6E6FA"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="👤"
                android:gravity="center"
                android:textSize="20sp"/>
        </androidx.cardview.widget.CardView>

        <TextView
            android:id="@+id/postAuthorName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="Torta_pounder67"
            android:textColor="#333333"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/postOptionsBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:clickable="true"
            android:focusable="true"
            android:onClick="showPostOptions"
            android:text="•••"
            android:textColor="#333333"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Post Content -->
    <TextView
        android:id="@+id/postContentText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:text="Anyone need help with stokes theorem? I have few notes."
        android:textColor="#333333"
        android:textSize="14sp" />

    <!-- Placeholder Image -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:layout_marginTop="12dp"
        android:background="#FFFFFF"
        android:padding="16dp"
        android:src="@android:drawable/ic_menu_gallery"
        app:tint="#CCCCCC" />

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#AAAAAA" />

    <!-- Actions -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">

        <TextView
            android:id="@+id/postApprovals"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:padding="4dp"
            android:text="👍 0 Approvals"
            android:textColor="#333"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/postDislikes"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:padding="4dp"
            android:text="👎 0 Dislikes"
            android:textColor="#333"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/postCommentsCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            android:padding="4dp"
            android:text="💬 0"
            android:textColor="#333"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>